"""BLCU Dr.COM HTTPS portal client for an ImmortalWrt WAN interface."""

import argparse
import base64
import fcntl
import getpass
import ipaddress
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from pathlib import Path
from urllib.parse import urlencode, urlsplit, urlunsplit

BASE = "https://login.blcu.edu.cn"
API = BASE + ":802/eportal/portal"
SECRETS = Path("/etc/blcu-portal/credentials.json")
LAST_LOGIN = SECRETS.parent / "last-login.json"
EVENT_LOG = SECRETS.parent / "authentication-log.json"
UPDATE_STATE = Path("/tmp/blcu-portal-update.json")
VERSION = "0.5.0"
POOL = SECRETS.parent / "accounts.json"
POOL_STATUS = Path("/tmp/blcu-portal-pool.json")
UPDATE_SOURCE = "https://github.com/DreamUniverse843/blcu-portal-openwrt/releases/latest"
CALLBACK = "blcuPortal"
INTERVAL = 60


class Retry(Exception):
    """A new network check can resolve this error."""


class Stop(Exception):
    """Local configuration or manual portal interaction is required."""


def ubus_status(object_name, argument=None):
    command = ["ubus", "call", object_name, "status"]
    if argument is not None:
        command.append(json.dumps(argument))
    result = subprocess.run(command, capture_output=True, timeout=5, check=False)
    if result.returncode:
        raise Retry("无法读取所选 WAN 的状态")
    return json.loads(result.stdout)


def read_interface(name):
    data = ubus_status("network.interface." + name)
    device = data.get("l3_device", "")
    if not data.get("up") or not device:
        raise Retry("校园网接口未连接")
    addresses = {}
    for version in (4, 6):
        addresses[version] = []
        for entry in data.get(f"ipv{version}-address", []):
            address = parse_address(entry.get("address"))
            if address and address.version == version and not address.is_link_local:
                addresses[version].append(str(address))
    if not any(addresses.values()):
        raise Retry("校园网接口尚未取得 IP 地址")
    try:
        hardware = ubus_status("network.device", {"name": device})
    except Retry:
        hardware = {}
    return {"name": name, "device": device, "addresses": addresses,
            "mac": format_mac(hardware.get("macaddr")),
            "kind": str(hardware.get("type") or "").lower()}


def parse_address(value):
    try:
        return ipaddress.ip_address(str(value).strip())
    except ValueError:
        return None


def format_mac(value):
    compact = re.sub(r"[:-]", "", str(value)).lower()
    if re.fullmatch(r"[0-9a-f]{12}", compact) and compact not in {"0" * 12, "1" * 12}:
        return ":".join(compact[i:i + 2] for i in range(0, 12, 2))
    return None


def request(device, server_ip, url, version, fields=None, *, family=None):
    query = urlencode({"callback": CALLBACK, "jsVersion": version, **(fields or {})})
    resolve = []
    if server_ip:
        endpoint = urlsplit(url)
        address = f"[{server_ip}]" if server_ip.version == 6 else str(server_ip)
        resolve = ["--resolve", f"{endpoint.hostname}:{endpoint.port or 443}:{address}"]
    # The URL, including login fields, goes to curl over stdin.
    result = subprocess.run(
        ["curl", "--disable", "--config", "-", "--noproxy", "*",
         "--interface", "if!" + device, "--proto", "=https", "--silent",
         "--fail", "--connect-timeout", "5", "--max-time", "10", "--max-filesize",
         "524288", "--write-out", r"\n%{local_ip} %{remote_ip} %{remote_port}",
         *resolve, *([f"-{family}"] if family else [])],
        input=f'url = "{url}?{query}"\n'.encode("ascii"),
        capture_output=True, timeout=12, check=False,
    )
    if result.returncode:
        raise Retry(f"HTTPS 请求失败（curl {result.returncode}）")
    body, _, connection = result.stdout.rpartition(b"\n")
    source, remote, port = connection.decode("ascii").split()
    source, remote = parse_address(source), parse_address(remote)
    if source is None or remote is None:
        raise Retry("无法确认 Portal 连接地址")
    try:
        payload = body.decode("utf-8")
    except UnicodeDecodeError:
        payload = body.decode("gb18030", errors="replace")
    match = re.fullmatch(r"\s*" + CALLBACK + r"\((.*)\)\s*;?\s*", payload, re.S)
    data = json.loads(match.group(1) if match else payload)
    if not isinstance(data, dict):
        raise Retry("Portal 返回了无法识别的响应")
    return data, {"source": str(source), "remote": str(remote), "port": int(port)}


def check_status(wan, server_ip, family=None, *, strict=False):
    family = family or (server_ip.version if server_ip else (4 if wan["addresses"][4] else 6))
    if not wan["addresses"][family]:
        raise Retry(f"校园网接口尚未取得 IPv{family} 地址")
    data, endpoint = request(wan["device"], server_ip, BASE + "/drcom/chkstatus",
                             "4.X", family=family)
    if endpoint["source"] not in wan["addresses"][family]:
        raise Retry("Portal 请求的源地址不属于所选校园网接口")
    result = str(data.get("result"))
    if result not in {"0", "1"}:
        raise Retry("Portal 返回了未知的在线状态")
    portal_addresses = [
        address for key in ("v46ip", "v4ip", "ss5", "v6ip", "myv6ip")
        if (address := parse_address(data.get(key))) and not address.is_unspecified
    ]
    reported_family = [str(addr) for addr in portal_addresses if addr.version == family]
    if reported_family and endpoint["source"] not in reported_family:
        raise Retry("Portal 返回的终端地址与所选 WAN 的源地址不一致")
    if result == "1" and endpoint["source"] not in reported_family:
        if strict or family != 6 or not any(str(addr) in wan["addresses"][4] for addr in portal_addresses):
            raise Retry("Portal 未确认所选 WAN 的在线状态")
    previous = data.get("stime", "")
    if not isinstance(previous, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}", previous):
        previous = ""
    return {"online": result == "1", "endpoint": endpoint,
            "account": data.get("uid"),
            "portal_mac": format_mac(data.get("ss4")),
            "portal_login_time": previous if result == "1" else ""}


def connection_paths(wan, server_ip, address_mode="auto", server_ipv6=None):
    if address_mode == "auto":
        return [(server_ip.version if server_ip else (4 if wan["addresses"][4] else 6), server_ip)]
    families = (4, 6) if address_mode == "dual" else (int(address_mode[-1]),)
    return [
        (version, next((ip for ip in (server_ipv6, server_ip) if ip and ip.version == version), None))
        for version in families
    ]


def read_path(wan, version, target):
    try:
        return check_status(wan, target, version, strict=True), None
    except (Retry, ValueError, OSError, subprocess.TimeoutExpired) as failure:
        reason = str(failure) if isinstance(failure, Retry) else "Portal 响应或接口状态无效"
        return None, reason


def check_connection(wan, server_ip, address_mode, server_ipv6):
    if address_mode == "auto":
        state = check_status(wan, server_ip)
        state["server_ip"] = server_ip
        return [state], {}
    addresses = connection_paths(wan, server_ip, address_mode, server_ipv6)
    with ThreadPoolExecutor(max_workers=len(addresses)) as pool:
        outcomes = list(pool.map(lambda path: read_path(wan, *path), addresses))
    states, failures = [], {}
    for (version, target), (state, error) in zip(addresses, outcomes):
        if state is not None:
            state["server_ip"] = target
            states.append(state)
        else:
            failures[version] = error
    return states, failures


def state_family(state):
    return ipaddress.ip_address(state["endpoint"]["source"]).version


def authentication_event(interface, event, reason="", family=None):
    entry = {"time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
             "interface": interface, "event": event, "reason": reason, "family": family}
    try:
        EVENT_LOG.parent.mkdir(mode=0o700, exist_ok=True)
        with (EVENT_LOG.parent / "authentication-log.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            events = read_events()
            write_private_json(EVENT_LOG, (events + [entry])[-100:])
    except OSError:
        print("无法写入认证日志", file=sys.stderr, flush=True)


def read_events():
    try:
        events = json.loads(EVENT_LOG.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return events if isinstance(events, list) else []


def rejection_reason(response):
    if response.get("auth_url") or response.get("self_auth_url"):
        return "Portal 要求在浏览器中完成身份验证"
    message = str(response.get("msg") or response.get("message") or "").lower()
    for keywords, reason in [
        (("密码", "password"), "校园网账号或密码未通过验证"),
        (("欠费", "余额不足", "逾期"), "校园网账户余额或有效期异常"),
        (("同时在线", "终端数", "在线数量"), "校园网在线终端数已达限制"),
        (("验证码", "captcha", "二次验证"), "Portal 要求人工验证"),
    ]:
        if any(word in message for word in keywords):
            return reason
    return "Portal 拒绝认证，请在校园网登录页查看详情"


def saved_login(interface, server_ip):
    try:
        previous = json.loads(LAST_LOGIN.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    if previous.get("interface") == interface and previous.get("server_ip") == str(server_ip or ""):
        return previous.get("time", "")
    return ""


def observe_login(wan, server_ip, state, *, confirmed=False):
    previous = saved_login(wan["name"], server_ip)
    current = state["portal_login_time"]
    if confirmed and not current:
        current = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    if current and current != previous:
        write_private_json(LAST_LOGIN, {
            "interface": wan["name"], "server_ip": str(server_ip or ""), "time": current
        })
    return current or previous


def configure():
    account = input("校园网账号（如需运营商后缀，请一并输入）: ").strip()
    password = getpass.getpass("校园网密码: ")
    save_credentials(account, password)
    print("已保存。正在运行的服务可通过 restart 重新读取配置。")


def validate_credentials(account, password):
    if (not isinstance(account, str) or not re.fullmatch(r"[A-Za-z0-9_.@-]{1,60}", account)
            or not isinstance(password, str) or not 1 <= len(password) <= 512):
        raise Stop("账号格式无效或未填写密码")


def save_credentials(account, password):
    validate_credentials(account, password)
    write_private_json(SECRETS, {"account": account, "password": password})


def write_private_json(path, data):
    path.parent.mkdir(mode=0o700, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        dir=path.parent, mode="w", encoding="utf-8", delete=False
    ) as handle:
        temp = Path(handle.name)
        try:
            json.dump(data, handle)
            handle.flush()
            os.fsync(handle.fileno())
            temp.replace(path)
        finally:
            temp.unlink(missing_ok=True)


def login(wan, server_ip, state, *, dual=False, credentials=None):
    source = state["endpoint"]["source"]
    family = ipaddress.ip_address(source).version
    ipv4 = source if family == 4 else next(iter(wan["addresses"][4]), "")
    ipv6 = source if family == 6 else (next(iter(wan["addresses"][6]), "") if dual else "")
    mac = state["portal_mac"] or wan["mac"] or "000000000000"
    config, config_connection = request(
        wan["device"], server_ip, API + "/page/loadConfig", "4.X",
        {"wlan_user_ip": base64.b64encode(ipv4.encode()).decode(),
         "wlan_user_ipv6": base64.b64encode(ipv6.encode()).decode(),
         "wlan_vlan_id": "1"}, family=family,
    )
    settings = config.get("data")
    if config_connection["source"] != source or not isinstance(settings, dict):
        raise Retry("接口发生变化，或无法读取 Portal 配置")
    for name, expected in {"login_method": "1", "check_online_method": "0",
                           "account_prefix": "0", "password_cut": "0",
                           "en_md5": "0"}.items():
        if str(settings.get(name)) != expected:
            raise Stop("Portal 认证配置与当前适配版本不符，请用浏览器登录")
    try:
        if credentials is None:
            credentials = json.loads(SECRETS.read_text(encoding="utf-8"))
        account = credentials["account"]
        password = credentials["password"]
    except (OSError, ValueError, KeyError) as failure:
        raise Stop("请先在 LuCI 设置中保存校园网账号，或运行 blcu-portal configure") from failure
    suffix = settings.get("account_suffix") or ""
    if suffix and not account.endswith(suffix) and "@" not in account:
        account += suffix
    try:
        response, _ = request(
            wan["device"], server_ip, API + "/login", "4.1.3",
            {"login_method": "1", "user_account": account, "user_password": password,
             "wlan_user_ip": ipv4, "wlan_user_ipv6": ipv6, "wlan_user_mac": mac.replace(":", ""),
             "wlan_ac_ip": "", "wlan_ac_name": "", "terminal_type": "1",
             "lang": "zh-cn"}, family=family,
        )
    except (Retry, ValueError, subprocess.TimeoutExpired) as failure:
        raise Stop("认证结果未知。请先查在线状态，再决定是否重新登录") from failure
    if (response.get("auth_url") or response.get("self_auth_url")
            or str(response.get("result")) not in {"1", "ok"}):
        raise Stop(rejection_reason(response))
    print("Portal 已接受登录，正在等待在线状态", flush=True)


def snapshot(interface, server_ip, address_mode="auto", server_ipv6=None):
    result = {"ok": False, "state": "unknown", "interface": interface,
              "server_ip": str(server_ip or ""), "status_port": 443, "login_port": 802,
              "last_login": saved_login(interface, server_ip), "paths": [], "version": VERSION}
    try:
        wan = read_interface(interface)
        result.update(device=wan["device"], mac=wan["mac"],
                      ipv4=wan["addresses"][4], ipv6=wan["addresses"][6])
        states, failures = check_connection(wan, server_ip, address_mode, server_ipv6)
        result["paths"] = sorted([
            {"family": state_family(state), "state": "online" if state["online"] else "offline",
             "endpoint": state["endpoint"]} for state in states
        ] + [{"family": version, "state": "unknown", "message": error}
             for version, error in failures.items()], key=lambda path: path["family"])
        online = next((state for state in states if state["online"]), None)
        if online:
            state = "partial" if failures or any(not path["online"] for path in states) else "online"
            result.update(ok=True, state=state, endpoint=online["endpoint"],
                          last_login=observe_login(wan, server_ip, online))
        elif states:
            result.update(state="offline", endpoint=states[0]["endpoint"])
        result["message"] = {
            "online": "校园网 WAN 已认证",
            "partial": "已确认部分地址族在线",
            "offline": "校园网 WAN 未认证",
            "unknown": "暂未确认校园网认证状态",
        }[result["state"]]
    except (Retry, ValueError, OSError, subprocess.TimeoutExpired) as failure:
        result["message"] = str(failure) if isinstance(failure, Retry) else "Portal 响应或接口状态无效"
    return result


def confirm_login(wan, server_ip, session=None, *, history_ip=None, expected_account=None):
    target = session["server_ip"] if session else server_ip
    for _ in range(3):
        time.sleep(2)
        state = (check_status(wan, target, state_family(session), strict=True)
                 if session else check_status(wan, target))
        if state["online"]:
            if expected_account and str(state.get("account") or "").strip() != expected_account:
                raise Stop("Portal 在线会话与账号池设置不一致")
            observe_login(wan, history_ip if session else server_ip, state, confirmed=True)
            return True
    return False


def attempt_login(wan, server_ip, session, address_mode, credentials=None):
    with open("/var/lock/blcu-portal.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as failure:
            raise Retry("已有认证请求正在运行") from failure
        family = state_family(session)
        expected = credentials["account"] if credentials else None
        authentication_event(wan["name"], "attempt", family=family)
        try:
            if address_mode == "auto":
                login(wan, server_ip, session, credentials=credentials)
                confirmed = confirm_login(wan, server_ip, expected_account=expected)
            else:
                login(wan, session["server_ip"], session, dual=address_mode == "dual", credentials=credentials)
                confirmed = confirm_login(
                    wan, session["server_ip"], session, history_ip=server_ip, expected_account=expected,
                )
        except (Retry, Stop, ValueError, subprocess.TimeoutExpired) as failure:
            reason = str(failure) if isinstance(failure, (Retry, Stop)) else "认证响应无效或连接超时"
            authentication_event(wan["name"], "failed", reason, family)
            raise
        if confirmed:
            authentication_event(wan["name"], "success", family=family)
        else:
            authentication_event(wan["name"], "unconfirmed", "Portal 接受登录，但尚未确认在线", family)
        return confirmed


def run(mode, interface, server_ip, interval, threshold, address_mode="auto", server_ipv6=None):
    if mode == "status":
        result = snapshot(interface, server_ip, address_mode, server_ipv6)
        print(result["message"])
        return {"online": 0, "partial": 0, "offline": 1, "unknown": 2}[result["state"]]

    delay = interval
    next_login = 0.0
    last_message = None
    offline_count = 0
    blocked = False
    credential_version = None
    while True:
        try:
            try:
                revision = SECRETS.stat().st_mtime_ns
            except OSError:
                revision = None
            if revision != credential_version:
                blocked = False
                credential_version = revision
            wan = read_interface(interface)
            states, failures = check_connection(wan, server_ip, address_mode, server_ipv6)
            online = [state for state in states if state["online"]]
            offline = [state for state in states if not state["online"]]
            if not states:
                raise Retry("；".join(f"IPv{family}：{error}" for family, error in failures.items()))
            if online:
                observe_login(wan, server_ip, online[0])
                offline_count = 0
                blocked = False
                message = "已确认部分地址族在线" if offline or failures else "校园网 WAN 已认证"
            else:
                offline_count += 1
                message = "校园网 WAN 未认证"
            should_login = offline and (mode == "login" or (not online and offline_count >= threshold))
            if should_login and not blocked and time.monotonic() >= next_login:
                confirmed = attempt_login(wan, server_ip, offline[0], address_mode)
                next_login = time.monotonic() + 300
                if confirmed:
                    message = "校园网 WAN 已认证"
                    offline_count = 0
                elif mode == "login":
                    raise Stop("暂未确认在线，请稍后执行 status")
            if message != last_message:
                print(message, flush=True)
                authentication_event(interface, "state", message)
                last_message = message
            if mode == "login":
                return 0
            delay = interval
        except Stop as failure:
            if mode == "login":
                raise
            print(str(failure), flush=True)
            blocked = True
            delay = interval
        except (Retry, ValueError, OSError, subprocess.TimeoutExpired) as failure:
            offline_count = 0
            message = str(failure) if isinstance(failure, Retry) else "Portal 响应或接口状态无效"
            if message != last_message:
                print(message, flush=True)
                authentication_event(interface, "check_failed", message)
                last_message = message
            if mode == "login":
                return 2
            delay = min(delay * 2, max(interval, 600))
        time.sleep(delay)


def account_summary(interface, server_ip, address_mode="auto", server_ipv6=None, credentials=None):
    saved = credentials if credentials is not None else read_mapping(SECRETS)
    stored = saved.get("account")
    if not stored:
        return {"message": "请先保存当前校园网账号"}
    try:
        wan = read_interface(interface)
        if address_mode == "auto":
            state = check_status(wan, server_ip)
        else:
            states, _ = check_connection(wan, server_ip, address_mode, server_ipv6)
            state = next((path for path in states if path["online"]), {"online": False})
    except (Retry, KeyError, ValueError, OSError, subprocess.TimeoutExpired):
        return {"message": "暂时无法确认当前校园网账户"}
    active = str(state.get("account") or "").strip()
    if not state["online"] or not active or active != stored:
        return {"message": "当前 WAN 须使用已保存的校园网账号在线，才能查询账户信息"}

    def query(action):
        family = ipaddress.ip_address(state["endpoint"]["source"]).version
        try:
            data, peer = request(
                wan["device"], state.get("server_ip", server_ip), API + "/User_info/" + action, "4.1.3",
                {"account": active}, family=family,
            )
        except (Retry, ValueError, OSError, subprocess.TimeoutExpired):
            return {}
        if str(data.get("code")) != "1" or peer["source"] != state["endpoint"]["source"]:
            return {}
        return data

    with ThreadPoolExecutor(max_workers=2) as pool:
        info, online = pool.map(query, ("loadUserInfo", "loadOnlineDevice"))
    result = {}
    for field in ("balance", "curr_group", "due_date", "next_group",
                  "use_flow", "remain_flow", "give_flow"):
        if field in info and isinstance(info[field], (str, int, float)):
            result[field] = info[field]
    devices = online.get("data")
    if isinstance(devices, list):
        result["online_devices"] = len(devices)
    if not result:
        result["message"] = "服务器暂未返回可显示的账户信息"
    return result


def read_mapping(path):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return {}
    return value if isinstance(value, dict) else {}


def edit_pool(primary, payload, *, remove=False):
    interface = payload.get("interface", "")
    if not isinstance(interface, str) or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]*", interface):
        raise Stop("请选择有效的网络接口")
    if interface == primary:
        raise Stop("这个接口已用于主连接")
    POOL.parent.mkdir(mode=0o700, exist_ok=True)
    with (POOL.parent / "accounts.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        accounts = read_mapping(POOL)
        if remove:
            accounts.pop(interface, None)
        else:
            previous = accounts.get(interface, {})
            account = payload.get("account") or previous.get("account")
            password = payload.get("password")
            if not password and account == previous.get("account"):
                password = previous.get("password")
            validate_credentials(account, password)
            existing = [row["account"] for name, row in accounts.items() if name != interface]
            main_account = read_mapping(SECRETS).get("account") if primary else None
            if main_account:
                existing.append(main_account)
            if any(value.casefold() == account.casefold() for value in existing):
                raise Stop("这个账号已绑定其他连接")
            result = subprocess.run(["ubus", "list", "network.interface." + interface],
                                    capture_output=True, timeout=4, check=False)
            if result.returncode or not result.stdout.strip():
                raise Stop("请先在网络 → 接口中配置此上联")
            accounts[interface] = {
                "account": account, "password": password, "enabled": payload.get("enabled") == "1"
            }
        write_private_json(POOL, accounts)


def pool_rows():
    # Return only fields needed by LuCI; the stored passwords stay in the service.
    current = read_mapping(POOL_STATUS)
    return [
        {"interface": name, "account": entry["account"], "enabled": entry["enabled"],
         "status": current.get(name, {"message": "等待检查"}) if entry["enabled"] else
         {"state": "disabled", "message": "已停用"}}
        for name, entry in read_mapping(POOL).items()
    ]


def identify_uplink(wan):
    device = wan["device"]
    if (not wan.get("mac") or wan.get("kind") in {"macvlan", "macvtap", "veth", "tunnel"}
            or device == "lo" or device.startswith(("tun", "tap", "zt", "wg", "ppp"))
            or (Path("/sys/devices/virtual/net") / device).exists()):
        raise Stop("账号池需要实际网络设备和固定的接口 MAC")
    return device, wan["mac"]


def pool_probe(primary, entries):
    occupied_devices, occupied_macs = set(), set()
    main_account = read_mapping(SECRETS).get("account") if primary else None
    if primary:
        try:
            wan = read_interface(primary)
        except (Retry, ValueError, OSError, subprocess.TimeoutExpired):
            # The primary can be down; still reserve its configured interface.
            pass
        else:
            occupied_devices.add(wan["device"])
            if wan["mac"]:
                occupied_macs.add(wan["mac"])
    candidates, statuses = {}, {}
    used_accounts = {main_account.casefold()} if main_account else set()
    for name, entry in entries.items():
        if not entry["enabled"]:
            statuses[name] = {"state": "disabled", "message": "已停用"}
            continue
        try:
            if name == primary or entry["account"].casefold() in used_accounts:
                raise Stop("接口或账号已绑定其他连接")
            wan = read_interface(name)
            device, mac = identify_uplink(wan)
            if device in occupied_devices or mac in occupied_macs:
                raise Stop("实际设备或 MAC 已被其他上联使用")
        except (Stop, Retry, ValueError, OSError, subprocess.TimeoutExpired) as failure:
            reason = str(failure) if isinstance(failure, (Stop, Retry)) else "无法确认上联状态"
            statuses[name] = {"state": "unknown", "message": reason}
            continue
        used_accounts.add(entry["account"].casefold())
        occupied_devices.add(device)
        occupied_macs.add(mac)
        candidates[name] = wan
    return candidates, statuses


def pool_cycle(primary, server_ip, address_mode, server_ipv6, threshold, previous):
    entries = read_mapping(POOL)
    if not entries:
        if read_mapping(POOL_STATUS):
            write_private_json(POOL_STATUS, {})
        return {}
    candidates, statuses = pool_probe(primary, entries)
    next_cycle = {}
    for name, wan in candidates.items():
        entry = entries[name]
        saved = previous.get(name, {})
        next_due, count, blocked = 0, 0, False
        if saved.get("entry") == entry:
            next_due = saved.get("next_due", 0)
            count = saved.get("count", 0)
            blocked = saved.get("blocked", False)
        status = {"device": wan["device"], "mac": wan["mac"]}
        try:
            paths, failures = check_connection(wan, server_ip, address_mode, server_ipv6)
            if not paths:
                raise Retry(next(iter(failures.values()), "暂未读取校园网状态"))
            online = next((path for path in paths if path["online"]), None)
            if online:
                active = str(online.get("account") or "").strip()
                if active != entry["account"]:
                    raise Stop("该上联的在线账号与账号池设置不一致")
                observe_login(wan, server_ip, online)
                status.update(state="online", message="已认证")
                count, blocked = 0, False
            else:
                count += 1
                status.update(state="offline", message="未认证")
                if blocked:
                    status["message"] = "上次认证失败，更新账号后重试"
                elif count >= threshold and time.monotonic() >= next_due:
                    session = dict(paths[0], portal_mac=None)
                    next_due = time.monotonic() + 300
                    if attempt_login(wan, server_ip, session, address_mode, credentials=entry):
                        status.update(state="online", message="已认证")
                        count = 0
        except Stop as failure:
            blocked = True
            status.update(state="failed", message=str(failure))
        except (Retry, ValueError, OSError, subprocess.TimeoutExpired) as failure:
            count = 0
            reason = str(failure) if isinstance(failure, Retry) else "暂未读到上联状态"
            status.update(state="unknown", message=reason)
        statuses[name] = status
        next_cycle[name] = {"entry": entry, "next_due": next_due, "count": count, "blocked": blocked}
    if statuses != read_mapping(POOL_STATUS):
        write_private_json(POOL_STATUS, statuses)
    return next_cycle


def pool_watch(primary, server_ip, address_mode, server_ipv6, interval, threshold):
    previous = {}
    while True:
        previous = pool_cycle(primary, server_ip, address_mode, server_ipv6, threshold, previous)
        # When the list changes, refresh without waiting for the next full interval.
        before = POOL.stat().st_mtime_ns if POOL.exists() else 0
        deadline = time.monotonic() + interval
        while time.monotonic() < deadline:
            time.sleep(min(5, max(0, deadline - time.monotonic())))
            try:
                updated = POOL.stat().st_mtime_ns
            except FileNotFoundError:
                updated = 0
            if updated != before:
                break


def release_source(value):
    source = value or UPDATE_SOURCE
    url = urlsplit(source)
    if (url.scheme != "https" or not url.hostname or url.username or url.password
            or url.fragment or url.query or not url.netloc.isascii()):
        raise ValueError("更新源须为 HTTPS 发布链接或 JSON 地址")
    match = re.fullmatch(r"/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/releases/?(?:latest)?/?", url.path)
    if url.hostname == "github.com" and match:
        owner, repository = match.groups()
        if {owner, repository} & {".", ".."}:
            raise ValueError("GitHub 仓库路径无效")
        return f"https://github.com/{owner}/{repository}/releases/latest"
    return urlunsplit(url)


def stable_version(version):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", str(version))
    return tuple(map(int, match.groups())) if match else None


def read_update():
    try:
        data = json.loads(UPDATE_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = {}
    return {"current": VERSION, **(data if isinstance(data, dict) else {})}


def fetch_release(source):
    target = urlsplit(source)
    github = target.hostname == "github.com" and target.path.endswith("/releases/latest")
    flags = (["--head", "--output", "/dev/null", "--write-out", "%{url_effective}"] if github
             else ["--header", "Accept: application/json"])
    result = subprocess.run(
        ["curl", "--disable", "--proto", "=https", "--proto-redir", "=https",
         "--location", "--max-redirs", "3", "--fail", "--silent",
         "--connect-timeout", "5", "--max-time", "12", "--max-filesize", "1048576",
         "--user-agent", f"blcu-portal/{VERSION}", *flags, "--url", source],
        capture_output=True, timeout=15, check=False,
    )
    if result.returncode:
        raise Retry(f"更新源访问失败（curl {result.returncode}）")
    if not github:
        return json.loads(result.stdout)
    link = result.stdout.decode("ascii").strip()
    effective = urlsplit(link)
    prefix = target.path.removesuffix("/latest") + "/tag/"
    if effective.hostname != "github.com" or not effective.path.lower().startswith(prefix.lower()):
        return {}
    return {"tag_name": effective.path[len(prefix):], "html_url": link}


def check_update(value):
    checked = {"checked_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
    try:
        release = fetch_release(release_source(value))
        latest = stable_version(release.get("tag_name"))
        if latest is None or release.get("draft") or release.get("prerelease"):
            raise Retry("更新源暂未发布正式版本")
        link = str(release.get("html_url") or "")
        page = urlsplit(link)
        link = link if page.scheme == "https" and page.hostname and not page.username else ""
        available = latest > stable_version(VERSION)
        checked.update(latest=".".join(map(str, latest)), available=available, link=link,
                       message="发现新版本" if available else "当前版本已是最新")
    except (AttributeError, OSError, ValueError, Retry, subprocess.TimeoutExpired) as failure:
        checked["message"] = str(failure) if isinstance(failure, Retry) else "更新源无效或响应超时"
    write_private_json(UPDATE_STATE, checked)
    return read_update()


def ipv6_upstreams(primary, exclusive):
    names = ([name for name, entry in read_mapping(POOL).items() if entry["enabled"]]
             if exclusive else [primary])
    result = subprocess.run(["ubus", "call", "network.interface", "dump"],
                            capture_output=True, timeout=5, check=False)
    if result.returncode:
        raise Retry("无法读取上游接口")
    interfaces = json.loads(result.stdout).get("interface", [])
    known = {item["interface"]: item for item in interfaces if "interface" in item}
    rows = []
    relevant = set()
    for name in names:
        main = known.get(name, {})
        device = main.get("l3_device") or main.get("device")
        related = [
            item for item in interfaces
            if item.get("interface") in {name, name + "_6", name + "6"}
            or (device and item.get("l3_device") == device and item.get("proto") == "dhcpv6")
        ]
        if not related:
            rows.append({"interface": name, "device": device, "up": False,
                         "addresses": [], "prefixes": [], "dns": [], "default_route": False})
            relevant.add(name)
        for item in related:
            upstream = item["interface"]
            if upstream in relevant:
                continue
            relevant.add(upstream)
            addresses, prefixes = [], []
            for entry in item.get("ipv6-address", []):
                address = parse_address(entry.get("address"))
                if address and address.version == 6 and not address.is_link_local:
                    addresses.append(f"{address}/{entry.get('mask', 128)}")
            for entry in item.get("ipv6-prefix", []):
                try:
                    prefix = ipaddress.IPv6Network(f"{entry['address']}/{entry['mask']}", strict=False)
                except (KeyError, ValueError):
                    continue
                if prefix.is_link_local or prefix.is_unspecified or entry.get("valid") in (0, "0"):
                    continue
                prefix_class = str(entry.get("class") or upstream)
                prefixes.append({"prefix": str(prefix), "class": prefix_class, "length": prefix.prefixlen,
                                 "preferred": entry.get("preferred"), "valid": entry.get("valid")})
            dns = [str(address) for value in item.get("dns-server", [])
                   if (address := parse_address(value)) and address.version == 6]
            default = any(route.get("target") == "::" and str(route.get("mask")) == "0"
                          for route in item.get("route", []))
            rows.append({"interface": upstream, "device": item.get("l3_device") or device,
                         "up": bool(item.get("up")), "addresses": addresses, "prefixes": prefixes,
                         "dns": dns, "default_route": default})
    return {"upstreams": rows}


def selected_pool_member():
    entries = {name: row for name, row in read_mapping(POOL).items() if row["enabled"]}
    current = read_mapping(POOL_STATUS)
    selected = next((name for name in entries if current.get(name, {}).get("state") == "online"), None)
    selected = selected or next(iter(entries), None)
    return selected, entries.get(selected)


def configured_status(interface, server_ip, address_mode, server_ipv6, exclusive):
    if not exclusive:
        return snapshot(interface, server_ip, address_mode, server_ipv6)
    member, _ = selected_pool_member()
    if member:
        status = snapshot(member, server_ip, address_mode, server_ipv6)
    else:
        status = {"ok": False, "state": "unknown", "message": "账号池还没有启用的上联", "version": VERSION}
    return {**status, "connection_mode": "pool", "fallback_interface": interface}


def serve_rpc(mode, interface, server_ip, address_mode, server_ipv6, update_source,
              pool_enabled, uplink_mode):
    exclusive = uplink_mode == "pool"
    if mode == "rpc-credentials":
        try:
            payload = json.load(sys.stdin)
            save_credentials(payload.get("account"), payload.get("password"))
        except (AttributeError, ValueError, Stop, OSError):
            print(json.dumps({"ok": False, "message": "账号格式无效或密码保存失败"}))
        else:
            print(json.dumps({"ok": True, "message": "校园网账号已保存"}))
        return 0

    if mode in {"rpc-pool-save", "rpc-pool-remove"}:
        try:
            payload = json.load(sys.stdin)
            if mode == "rpc-pool-save" and payload.get("account") == ":main-credentials":
                if not exclusive or payload.get("interface") != interface:
                    raise Stop("选择并应用账号池后，才能把主连接账号沿用到原接口")
                saved = read_mapping(SECRETS)
                payload.update(account=saved.get("account"), password=saved.get("password"))
            edit_pool(None if exclusive else interface, payload, remove=mode == "rpc-pool-remove")
        except (AttributeError, ValueError, OSError, Stop, subprocess.TimeoutExpired) as failure:
            message = str(failure) if isinstance(failure, Stop) else "无法保存账号池"
            print(json.dumps({"ok": False, "message": message}))
        else:
            print(json.dumps({"ok": True, "message": "账号池已更新"}))
        return 0
    if mode == "rpc-pool":
        entries = pool_rows()
        if not pool_enabled:
            for entry in entries:
                entry["status"] = {"state": "disabled", "message": "账号池未启用"}
        print(json.dumps({"entries": entries, "enabled": pool_enabled, "exclusive": exclusive,
                          "fallback_interface": interface}))
        return 0
    if mode == "rpc-ipv6":
        try:
            status = ipv6_upstreams(interface, exclusive)
        except (Retry, ValueError, OSError, subprocess.TimeoutExpired):
            status = {"upstreams": [], "message": "暂时无法读取 IPv6 上游状态"}
        print(json.dumps(status))
        return 0
    if mode == "rpc-logs":
        print(json.dumps({"entries": list(reversed(read_events()))}))
        return 0
    if mode == "rpc-update":
        print(json.dumps(read_update()))
        return 0
    if mode == "rpc-check-update":
        print(json.dumps(check_update(update_source)))
        return 0
    if mode == "rpc-account":
        if exclusive:
            member, credentials = selected_pool_member()
            account = (account_summary(member, server_ip, address_mode, server_ipv6, credentials)
                       if member else {"message": "账号池还没有启用的上联"})
        else:
            account = account_summary(interface, server_ip, address_mode, server_ipv6)
        print(json.dumps(account))
        return 0
    if mode == "rpc-status":
        print(json.dumps(configured_status(interface, server_ip, address_mode, server_ipv6, exclusive)))
        return 0
    if exclusive:
        print(json.dumps({"message": "账号池自动检测各条已启用上联，请在连接页查看状态。"}))
        return 0

    command = [sys.executable, "/usr/bin/blcu-portal", "login", "--interface", interface,
               "--address-mode", address_mode]
    if server_ip:
        command += ["--server-ip", str(server_ip)]
    if server_ipv6:
        command += ["--server-ipv6", str(server_ipv6)]
    # rpcd has a short request deadline; the client owns locking and logging.
    subprocess.Popen(
        ["/bin/sh", "-c", '"$@" 2>&1 | logger -t blcu-portal', "blcu-portal", *command],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    print(json.dumps({"ok": True, "message": "已请求单次认证，请稍后刷新状态或查看系统日志。"}))
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("mode", choices=["status", "login", "watch", "configure",
                                         "rpc-status", "rpc-login", "rpc-credentials", "rpc-account",
                                         "rpc-logs", "rpc-update", "rpc-check-update", "update-watch",
                                         "rpc-pool", "rpc-pool-save", "rpc-pool-remove", "pool-watch", "rpc-ipv6"])
    parser.add_argument("--interface", default="wan")
    parser.add_argument("--server-ip", default="", help="认证服务器 IP 地址，留空使用系统 DNS")
    parser.add_argument("--pool-enabled", choices=["0", "1"], default="0")
    parser.add_argument("--uplink-mode", choices=["legacy", "single", "pool"], default="legacy")
    parser.add_argument("--address-mode", choices=["auto", "ipv4", "ipv6", "dual"], default="auto")
    parser.add_argument("--server-ipv6", default="")
    parser.add_argument("--update-source", default="")
    parser.add_argument("--update-hours", type=int, default=24)
    parser.add_argument("--interval", type=int, default=INTERVAL)
    parser.add_argument("--threshold", type=int, default=2)
    args = parser.parse_args()
    if not 15 <= args.interval <= 3600 or not 1 <= args.threshold <= 10:
        parser.error("检测间隔须为 15–3600 秒，连续离线次数须为 1–10")
    if not 1 <= args.update_hours <= 168:
        parser.error("更新检查周期须为 1–168 小时")
    try:
        server_ip = ipaddress.ip_address(args.server_ip) if args.server_ip else None
        server_ipv6 = ipaddress.IPv6Address(args.server_ipv6) if args.server_ipv6 else None
    except ValueError:
        parser.error("认证服务器 IP 地址无效")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]*", args.interface):
        parser.error("接口应为 LuCI 中的逻辑接口名")
    try:
        if args.mode.startswith("rpc-"):
            return serve_rpc(args.mode, args.interface, server_ip, args.address_mode,
                             server_ipv6, args.update_source,
                             args.uplink_mode == "pool" or args.pool_enabled == "1",
                             args.uplink_mode)
        if args.mode == "pool-watch":
            primary = None if args.uplink_mode == "pool" else args.interface
            pool_watch(primary, server_ip, args.address_mode, server_ipv6, args.interval, args.threshold)
            return 0
        if args.mode == "update-watch":
            while True:
                check_update(args.update_source)
                time.sleep(args.update_hours * 3600)
        if args.mode == "configure":
            configure()
            return 0
        return run(args.mode, args.interface, server_ip, args.interval, args.threshold,
                   args.address_mode, server_ipv6)
    except (Stop, OSError) as failure:
        print(str(failure) if isinstance(failure, Stop) else "无法读取本地配置或运行依赖")
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
