#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local enabled interface server_ip server_ipv6 address_mode interval threshold
	local update_enabled update_source update_hours
	config_load blcu-portal
	config_get_bool enabled main enabled 0
	config_get_bool update_enabled main update_enabled 1
	config_get interface main interface wan
	config_get server_ip main server_ip
	config_get server_ipv6 main server_ipv6
	config_get address_mode main address_mode auto
	config_get interval main check_interval 60
	config_get threshold main offline_checks 2
	config_get update_source main update_source
	config_get update_hours main update_hours 24

	if [ "$enabled" -eq 1 ]; then
		procd_open_instance auth
		procd_set_param command /usr/bin/blcu-portal watch --interface "$interface" \
			--server-ip "$server_ip" --server-ipv6 "$server_ipv6" --address-mode "$address_mode" \
			--interval "$interval" --threshold "$threshold"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
	if [ "$update_enabled" -eq 1 ]; then
		procd_open_instance updates
		procd_set_param command /usr/bin/blcu-portal update-watch \
			--update-source "$update_source" --update-hours "$update_hours"
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger blcu-portal
}
