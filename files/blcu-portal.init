#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local enabled interface server_ip interval threshold
	config_load blcu-portal
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get interface main interface wan
	config_get server_ip main server_ip
	config_get interval main check_interval 60
	config_get threshold main offline_checks 2

	procd_open_instance
	procd_set_param command /usr/bin/blcu-portal watch --interface "$interface" --server-ip "$server_ip" \
		--interval "$interval" --threshold "$threshold"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger blcu-portal
}
